{
  "uid": "homelab-traces",
  "title": "Traces",
  "tags": [
    "homelab",
    "traces"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "refresh": "1m",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "type": "table",
      "title": "Recent traces (OpenTelemetry via Alloy)",
      "datasource": {
        "type": "tempo",
        "uid": "tempo"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 12
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "tempo",
            "uid": "tempo"
          },
          "queryType": "traceql",
          "query": "{ $service }",
          "limit": 50,
          "tableType": "traces"
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Spans received by Tempo",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 12,
        "w": 24,
        "h": 7
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(rate(tempo_distributor_spans_received_total[5m]))",
          "legendFormat": "spans/s"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "fillOpacity": 10
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    }
  ],
  "templating": {
    "list": [
      {
        "name": "service",
        "label": "TraceQL filter",
        "type": "textbox",
        "query": "true",
        "current": {
          "text": "true",
          "value": "true"
        },
        "description": "For example: resource.service.name = \"my-app\""
      }
    ]
  },
  "annotations": {
    "list": []
  }
}
