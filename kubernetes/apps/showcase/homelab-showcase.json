    },
    {
      "id": 15,
      "type": "timeseries",
      "title": "Metric series (Prometheus)",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 16,
        "y": 19,
        "w": 8,
        "h": 7
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(prometheus_tsdb_head_series)",
          "legendFormat": "series"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "fillOpacity": 15,
