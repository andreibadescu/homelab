{
  "name": "homelab",
  "build": { "dockerfile": "Dockerfile" },
  "workspaceFolder": "/workspace",
  "workspaceMount": "source=${localWorkspaceFolder},target=/workspace,type=bind",
  "remoteUser": "root",
  "mounts": [
    "source=${localEnv:HOME}/.homelab,target=/root/.homelab,type=bind",
    "source=${localEnv:HOME}/Library/Application Support/sops/age/keys.txt,target=/root/.config/sops/age/keys.txt,type=bind,readonly"
  ]
}
