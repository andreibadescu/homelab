// Access policy of the homelab tailnet (applied by tailscale.tf; edits in the admin console are
// overwritten on the next `make apply`).
{
	"tagOwners": {
		// The Tailscale operator in the cluster runs as tag:k8s-operator and creates its proxies
		// (one device per app) as tag:k8s.
		"tag:k8s-operator": ["autogroup:admin"],
		"tag:k8s":          ["tag:k8s-operator"],
	},
	"grants": [
		// Members of this tailnet and people a device is shared with may open the apps over HTTPS,
		// and nothing else. Devices are shared one by one in the admin console.
		{
			"src": ["autogroup:member", "autogroup:shared"],
			"dst": ["tag:k8s"],
			"ip":  ["tcp:443"],
		},
	],
}
